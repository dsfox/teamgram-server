# An image made of ready binaries: no compilation happens here.
#
# The binaries are built on the workstation by server/build-linux.sh — Go
# compiles for a foreign architecture without emulation, which takes half a
# minute instead of tens of minutes on the server. All the server has to do is
# place them into an image next to ffmpeg.
#
# Build: docker build -f Dockerfile.prebuilt -t ice9-server .
# Named rather than latest, which is whatever Ubuntu released last: the next
# build would change the system under the server without a word. 26.04 is
# what the stand and production were running on 23 September 2026.
FROM ubuntu:26.04
# ffmpeg is mandatory: it produces the first video frame used as a thumbnail.
# Without a thumbnail the client does not show the video in a chat — verified in
# practice, it looks like "the message never arrived". We install only it and
# psmisc (killall in the startup scripts).
RUN apt update -y && apt install -y ffmpeg psmisc && apt-get clean

WORKDIR /app
COPY teamgramd/ /app/
RUN chmod +x /app/docker/entrypoint.sh /app/bin/*
ENTRYPOINT /app/docker/entrypoint.sh
